/ios/NativePHP-simulator-Info.plist

# iOS PHP runtime (extracted at build time)
/ios/Include
/ios/Libraries

# iOS app bundle (packaged at build time)
/ios/NativePHP/app.zip
/ios/NativePHP/bundle_meta.json
/ios/NativePHP/bundled.version
